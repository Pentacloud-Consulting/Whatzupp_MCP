<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>WhatZupp Floating Launcher</masterLabel>
    <description>Floating action button to launch WhatZupp from anywhere on the page.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage">
            <property name="launchMode" type="String" default="Modal" label="Launch Mode" description="Choose how to launch the app (Modal or Tab)" datasource="Modal,Tab"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
